#!/bin/bash
# prerm script for fadcrypt
# This script runs before the package is removed

set -e

case "$1" in
    remove|upgrade|deconfigure)
        echo "Running FadCrypt cleanup..."
        
        # Stop elevated daemon service if running
        if command -v systemctl >/dev/null 2>&1; then
            echo "Stopping FadCrypt elevated daemon..."
            systemctl stop fadcrypt-elevated.service 2>/dev/null || true
            systemctl disable fadcrypt-elevated.service 2>/dev/null || true
        fi
        
        # Run cleanup if the binary still exists (now using wrapper script path)
        if [ -x /usr/bin/fadcrypt ]; then
            echo "Running cleanup to unlock files and restore system state..."
            # Export SUDO_USER so cleanup knows the real user's home directory
            # but run with root privileges (don't use su)
            export SUDO_USER="${SUDO_USER:-$USER}"
            
            # Use --internal-auth to bypass password prompt (automated uninstall)
            # prerm runs as root, so it has permission to cleanup
            /usr/bin/fadcrypt --cleanup --internal-auth 2>/dev/null || {
                echo "⚠️  Automatic cleanup failed - some files may remain locked"
                echo "   Run manually: sudo fadcrypt --cleanup"
            }
            
            echo "✓ Cleanup completed."
        else
            echo "⚠️  FadCrypt binary not found, skipping cleanup"
        fi
        
        # Remove socket directory on full removal
        if [ "$1" = "remove" ]; then
            rm -rf /run/fadcrypt 2>/dev/null || true
            echo "✓ Removed runtime socket directory"
        fi
        ;;
        
    failed-upgrade)
        ;;
        
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
